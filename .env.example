# ==========================================
# Backend Configuration (Place in backendv2/.env)
# ==========================================

# Port for the FastAPI backend
PORT=9100

# Serper API Key (for web search/fallback discovery)
SERPER_API_KEY="your_serper_api_key_here"

# Google Gemini API Key (primary LLM for extraction/generation)
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (fast LLM for classification and fallback)
GROQ_API_KEY="your_groq_api_key_here"


# ==========================================
# Frontend Configuration (Place in frontend/.env)
# ==========================================

# Port for the Frontend dev server
PORT=4174

# Base URL for the backend API
VITE_API_BASE_URL="http://localhost:9100"

